#, python-format
msgctxt "model:ir.message,text:bom_already_exists"
msgid "A bom already exists for cost plan \"%(cost_plan)s\"."
msgstr "A(z) „%(cost_plan)s” költségtervhez már létezik darabjegyzék."

#, python-format
msgctxt "model:ir.message,text:delete_system_cos"
msgid ""
"You can not delete cost \"%(cost)s\" from plan \"%(plan)s\" because it's "
"managed by system."
msgstr ""
"A(z) „%(cost)s” költség nem törölhető a(z) „%(plan)s” tervből, mert a "
"rendszer kezeli."

#, python-format
msgctxt "model:ir.message,text:lacks_the_product"
msgid "The Cost Plan \"%(cost_plan)s\" lacks the product."
msgstr "A(z) „%(cost_plan)s” költségtervből hiányzik a termék."

#, python-format
msgctxt "model:ir.message,text:msg_operation_line_quantity_uom_required"
msgid ""
"The operation line \"%(line)s\" requires a Quantity UoM for standard "
"calculation."
msgstr ""
"A(z) „%(line)s” műveleti tételnél a normál számításhoz mennyiségi "
"mértékegység szükséges."

#, python-format
msgctxt "model:ir.message,text:msg_product_line_plan_parent"
msgid "The line \"%(line)s\" can only set plan or parent, not both options."
msgstr ""
"A(z) „%(line)s” tételnél csak a terv vagy a szülő állítható be, mindkettő "
"nem."

msgctxt "model:ir.message,text:msg_step_lines_missing_routing_information"
msgid ""
"You have step lines with not enough information to create a production "
"routing. Ensure that the fields \"operation\", \"calculation\" and \"time\" "
"are filled."
msgstr ""
"Egyes lépéstételeknél nincs elegendő információ a gyártási műveletterv "
"létrehozásához. Ellenőrizze, hogy a „művelet”, „számítás” és „idő” mezők ki "
"vannak-e töltve."

#, python-format
msgctxt "model:ir.message,text:product_already_has_bom"
msgid "Product \"%(product)s\" already has a BOM assigned."
msgstr "A(z) „%(product)s” termékhez már van darabjegyzék rendelve."

msgctxt "model:ir.message,text:product_lines_will_be_removed"
msgid "It will remove the existing Product Lines in this plan."
msgstr "Ez eltávolítja a terv meglévő terméktételeit."

