msgctxt "help:product.cost.plan.product_line,party_stock:"
msgid "Use stock owned by party instead of company stock."
msgstr ""
"A vállalat készlete helyett a partner tulajdonában lévő készlet használata."

msgctxt "help:product.cost.plan.product_line,total_cost:"
msgid "The cost of this product for total plan's quantity."
msgstr "E termék költsége a terv teljes mennyiségére."

msgctxt "help:product.cost.plan.product_line,unit_cost:"
msgid "The cost of this product for each unit of plan's product."
msgstr "E termék költsége a tervben szereplő termék egy egységére."

msgctxt "help:product.cost.plan.step_line,calculation:"
msgid ""
"Use Standard to multiply the amount of time by the number of units produced."
" Use Fixed to use the indicated time once for the full plan quantity."
msgstr ""
"A Normál beállítás az időt megszorozza a gyártott egységek számával. A "
"Rögzített beállítás a megadott időt egyszer veszi figyelembe a terv teljes "
"mennyiségére."

msgctxt "help:product.cost.plan.step_line,quantity:"
msgid "Quantity of the plan product processed by the specified time."
msgstr ""
"A tervben szereplő termékből a megadott idő alatt feldolgozott mennyiség."

msgctxt "help:product.cost.plan.step_line,total_cost:"
msgid "The cost of this operation for total plan's quantity."
msgstr "E művelet költsége a terv teljes mennyiségére."

msgctxt "help:product.cost.plan.step_line,unit_cost:"
msgid "The cost of this operation for each unit of plan's product."
msgstr "E művelet költsége a tervben szereplő termék egy egységére."

